        {
            "name" : "foliate",
            "buildsystem" : "meson",
            "sources" : [
                {
                    "type" : "git",
                    "branch": "gtk4",
                    "url": "https://github.com/johnfactotum/foliate.git"
                }
            ]
        }
    ]
